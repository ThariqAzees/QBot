# Copy this file to .env and fill in your own values.

# Google Gemini API Key (Free tier available at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas connection string (Database > Connect > Drivers)
# A free M0 cluster supports Atlas Vector Search.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vf6uutb.mongodb.net/?appName=Cluster0

# --- Optional overrides (defaults shown) ---
# QBOT_DB_NAME=qbot
# QBOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QBOT_CHAT_MODEL=gemini-flash-lite-latest
# QBOT_CHUNK_SIZE_TOKENS=400
# QBOT_CHUNK_OVERLAP_TOKENS=60
# QBOT_TOP_K=5
# QBOT_NUM_CANDIDATES=100
# QBOT_HIGH_SIMILARITY=0.65
# QBOT_LOW_SIMILARITY=0.40
# QBOT_MANIPULATION_THRESHOLD=0.65
# QBOT_HISTORY_TURNS=6
